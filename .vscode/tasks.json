  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Dev + туннель БД",
      "detail": "scripts/dev.sh — SSH-туннель к БД VPS + npm run dev. НУЖЕН для страниц с БД (иначе 500). Ctrl+Shift+B.",
      "type": "shell",
      "command": "bash scripts/dev.sh",
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "review" },
      "options": {
        "shell": {
          "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
          "args": ["-lc"]
        }
      }
    },
    {
      "label": "▶ Dev-сервер (без туннеля)",
      "detail": "npm run dev без туннеля — только для страниц БЕЗ БД (иначе 500). Обычно бери «Dev + туннель БД».",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "review" }
    },
    {
      "label": "🏗 Build (проверка типов)",
      "detail": "npm run build — отловить тип-ошибки/сборку до коммита",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "🧹 Lint",
      "detail": "npm run lint — eslint",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "📊 Стиль-долг: проверить (debt:check)",
      "detail": "Сверить NIGHTFALL-счётчики в snapshot с src/ (exit 1 если устарели). Не пишет.",
      "type": "shell",
      "command": "npm run debt:check",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "✍ Стиль-долг: пересчитать (debt:sync)",
      "detail": "Пересчитать и переписать авто-блок стиль-долга в snapshot из src/.",
      "type": "shell",
      "command": "npm run debt:sync",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
