# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright snapshots (heavy binary files — baseline not committed)
tests/**/*-snapshots/
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code internal
.claude/

# Голосовые заметки — исходное аудио; в репо держим только транскрипты (docs/voice-notes/transcripts/).
docs/voice-notes/*.ogg

# Item icons — отдаём из Supabase Storage (bucket cta-media), в репо не держим.
# Локальные .webp остаются на диске как офлайн-фолбэк (см. src/lib/item-icon.ts).
# items_database.json / fetch_tarkov_db.py / search_index.txt — остаются в гите.
public/images/items/eft/*.webp

# Достижения: веб-иконки eft/*.webp — В РЕПО (их отдаёт src/lib/achievement-icon.ts из public).
# А исходники (мастера ~2000px + JPG-плитки видео) под .../недостающие/ — heavy и под public
# (улетели бы в деплой Vercel). Держим локально, как прочие asset-дампы.
public/images/achievements/eft/недостающие/

# Референс-скрины из игры (source-of-truth для текстов достижений/перков) — тяжёлые бинарники,
# держим локально в валте, как голосовые. Спеки ссылаются на них по пути.
docs/eft/codex/
docs/eft/progress/seasons/build-constructor/

# Design sync — generated/machine state (durable set in .design-sync/ IS committed)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Local working/non-project files (reverse-engineering tools, asset dumps, scratch).
# Имя папки начинается с "!", поэтому экранируем — иначе git трактует "!" как "не игнорировать".
\!non-related/
\!future-requests/

# Скретч-директория (референс-скрины Figma, временные выгрузки) — локальное, не в репо.
/.tmp/
/.scratch/

# Render-pipeline стейджинг (webp по человекочитаемым именам ДО заливки в Supabase) — артефакт, не исходник.
public/images/items/frago/
# Отчёты find-missing (tsv/json выгрузки) — генерятся, в репо не держим.
/scripts/reports/

# Слепки бандлов клиента ДО патча (диф новых ассетов) — машинно-зависимый throwaway
# (Windows.json ~2.6 МБ). Снимается перед патчем, удаляется после дифа. Не в репо.
/scripts/icon-render/snapshots/

# Рендер-скретч иконок (extract-меши/OBJ, Unity PNG, webp-превью) — локальный throwaway.
/scripts/icon-render/out-poc/
/scripts/icon-render/out-unity/
/scripts/icon-render/.work-unity/

# graphify — генерируемый граф кода (корневой = живой, src/ = старый артефакт). Не версионируем.
graphify-out/

# Локальные экспорты карт (генерятся scripts/export-maps-svg.ts) и внешние ресёрч-тулзы
map-exports/
\!for-deep-research/

# Кэш тайлов карт (scripts/fetch-tiles.mjs) — сырые PNG с assets.tarkov.dev.
# Растёт быстро: Лаборатория на z=6 это ~218 МБ. Артефакт, не исходник.
/.tile-cache/

# Арт-воркспейс карт (PNG/SVG-мастера, тайл-пирамиды, вектор-оверлеи) — локальный тест, НЕ в прод/git.
# ~22k файлов + сотни МБ раздули бы git и Vercel-деплой; прод-хостинг = R2/Storage (отдельное решение).
/public/maps/

# Логи локального dev-сервера (next dev) — артефакт, не исходник.
.devlog.*

# tesseract.js в Node качает языковые traineddata в CWD (корень) при OCR-скриптах —
# это кэш, не исходник. Модель компаньона живёт в public/tessdata/ (её НЕ игнорим).
/*.traineddata

# Конфиг валта Obsidian в корне проекта (плагины, тема, воркспейс) — локальная
# настройка редактора, как и docs/.obsidian. Появляется, если открыть корень
# проекта как валт, чтобы Claudian получил правильную рабочую директорию.
/.obsidian/

# Сессии и настройки плагина Claudian (Claude Code внутри Obsidian) — локальное.
/.claudian/
.figma-tmp/

# Скачанное сырьё с kord-map-mtdv.ru (CC BY-NC-SA), не коммитим
kord-import/

# OS/тулинг-артефакты — не в репо
desktop.ini
.autopilot/

# Бэкап-архив редундантных картинок, переехавших на R2 (achievements/quests/bosses/
# seasons/battlepass/character). На диске как офлайн-копия, в репо НЕ нужны — раздаёт R2.
/image-archive/

# отчёты диагностики RU-доступа (локальные, в git не нужны)
diag-ru-*.txt
